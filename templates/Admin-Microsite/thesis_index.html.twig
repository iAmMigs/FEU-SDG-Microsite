{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block page_actions %}
    <div class="d-flex align-items-center gap-2 me-2">
        <select class="form-select" id="yearFilter" onchange="applyYearFilter(this.value)" style="width: auto; height: 38px;">
            <option value="">Filter by Year</option>
            {% for year in range("now"|date("Y"), 1990) %}
                <option value="{{ year }}" {% if app.request.query.get('researchYear') == year %}selected{% endif %}>{{ year }}</option>
            {% endfor %}
        </select>
    </div>
    {{ parent() }}
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        function applyYearFilter(year) {
            const url = new URL(window.location.href);
            if (year) {
                url.searchParams.set('researchYear', year);
            } else {
                url.searchParams.delete('researchYear');
            }
            // Reset to page 1 when filtering
            url.searchParams.delete('page');
            window.location.href = url.toString();
        }
    </script>
    
    <div class="modal fade" id="csvImportModal" tabindex="-1" aria-labelledby="csvImportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form id="csvImportForm" action="{{ path('admin_project_import_csv') }}" method="POST" enctype="multipart/form-data">
                    
                    <div class="modal-header">
                        <h5 class="modal-title" id="csvImportModalLabel">Add Multiple Projects (CSV)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Note:</strong> Make sure your data exactly matches the format of the project table. The first row must be the headers:
                            <br><br>
                            <code>Authors, Title, Abstract, DOI, Type, College, SDG</code>
                        </div>
                        
                        <div class="mb-4">
                            <label for="researchYearSelect" class="form-label">Year of Research</label>
                            <select class="form-select" id="researchYearSelect" name="research_year" required>
                                <option value="" selected disabled>Select a Year</option>
                                {% for year in range("now"|date("Y"), 1990) %}
                                    <option value="{{ year }}">{{ year }}</option>
                                {% endfor %}
                            </select>
                            <div class="form-text">This year will be applied to all projects in the uploaded CSV.</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="csvFileInput" class="form-label">Upload CSV File</label>
                            <input class="form-control" type="file" id="csvFileInput" name="csv_file" accept=".csv" required>
                            <div id="fileValidationFeedback" class="form-text text-danger mt-2" style="display: none;"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="confirmImportBtn" disabled>Confirm Upload</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# Advanced Batch Management Modal #}
    <div class="modal fade" id="advancedBatchModal" tabindex="-1" aria-labelledby="advancedBatchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content overflow-hidden" style="border-radius: 16px; border: none; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);">
                <div class="modal-header border-bottom py-3" style="background-color: #f0fdf4;">
                    <h5 class="modal-title fw-bold" id="advancedBatchModalLabel" style="color: #166534;">
                        <i class="fas fa-tasks me-2"></i> Advanced Batch Project Management
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 bg-white">
                    {# Filter Bar #}
                    <div class="bg-white border-bottom p-4">
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted mb-2" style="letter-spacing: 0.5px;">Search Projects</label>
                            <div class="position-relative shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <i class="fas fa-search position-absolute" style="left: 15px; top: 50%; transform: translateY(-50%); z-index: 10; color: #166534; opacity: 0.7;"></i>
                                <input type="text" class="form-control border-0 bg-light" id="batchFilterKeyword" placeholder="Search by Title..." style="font-size: 14px; padding: 12px 15px 12px 45px; color: #1a1a1a; font-weight: 500; background-color: #f8fafc !important;">
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-uppercase text-muted mb-2" style="letter-spacing: 0.5px;">SDG Category</label>
                                <select class="form-select shadow-sm border-light" id="batchFilterSdg" style="border-radius: 8px;">
                                    <option value="">All SDGs</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-uppercase text-muted mb-2" style="letter-spacing: 0.5px;">Year</label>
                                <select class="form-select shadow-sm border-light" id="batchFilterYear" style="border-radius: 8px;">
                                    <option value="">All Years</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-uppercase text-muted mb-2" style="letter-spacing: 0.5px;">Project Type</label>
                                <select class="form-select shadow-sm border-light" id="batchFilterType" style="border-radius: 8px;">
                                    <option value="">All Types</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-uppercase text-muted mb-2" style="letter-spacing: 0.5px;">Current Status</label>
                                <select class="form-select shadow-sm border-light" id="batchFilterStatus" style="border-radius: 8px;">
                                    <option value="">All Statuses</option>
                                    <option value="1">Active Only</option>
                                    <option value="0">Inactive Only</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    {# Dual Table Container #}
                    <div class="row g-0" style="height: 420px;">
                        {# Available Projects (Left) #}
                        <div class="col-md-5 border-end d-flex flex-column h-100 bg-light bg-opacity-10">
                            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                                <span class="small fw-bold text-muted text-uppercase" style="letter-spacing: 1px;">Available Projects (<span id="availableCount">0</span>)</span>
                                <button class="btn btn-sm btn-outline-primary fw-bold" style="font-size: 11px; border-radius: 6px;" onclick="batchManager.targetAll()">TARGET ALL</button>
                            </div>
                            <div class="overflow-auto flex-grow-1" id="availableListContainer" style="background-color: #f8fafc;">
                                <table class="table table-sm table-hover mb-0" style="font-size: 13px;">
                                    <tbody id="availableTableBody">
                                        {# Dynamic Content #}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        {# Middle Divider #}
                        <div class="col-md-2 d-flex flex-column align-items-center justify-content-center bg-white border-end shadow-sm z-1">
                            <div class="text-center p-4">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="fas fa-exchange-alt fa-lg text-muted opacity-50"></i>
                                </div>
                                <p class="small text-muted fw-bold mb-0">Use arrows to move</p>
                            </div>
                        </div>

                        {# Targeted Projects (Right) #}
                        <div class="col-md-5 d-flex flex-column h-100" style="background-color: #fefce8;"> {# FEU Gold Tint #}
                            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                                <span class="small fw-bold text-warning text-uppercase" style="letter-spacing: 1px; color: #a16207 !important;">List of Projects to Update (<span id="targetedCount">0</span>)</span>
                                <button class="btn btn-sm btn-outline-danger fw-bold" style="font-size: 11px; border-radius: 6px;" onclick="batchManager.clearTargeted()">CLEAR ALL</button>
                            </div>
                            <div class="overflow-auto flex-grow-1" id="targetedListContainer">
                                <table class="table table-sm table-hover mb-0" style="font-size: 13px;">
                                    <tbody id="targetedTableBody">
                                        {# Dynamic Content #}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top p-4">
                    <div class="me-auto text-muted small">
                        <i class="fas fa-info-circle me-1 text-primary"></i> Updates will be applied globally across all pages.
                    </div>
                    <button type="button" class="btn btn-link text-muted fw-bold text-decoration-none px-4" data-bs-dismiss="modal">Cancel</button>
                    <div class="btn-group gap-2">
                        <button type="button" class="btn btn-danger fw-bold px-4 shadow-sm" style="border-radius: 8px !important; border: none;" onclick="batchManager.executeDelete()" id="btnDeleteBatch" disabled>
                            <i class="fas fa-trash-alt me-2"></i> DELETE
                        </button>
                        <button type="button" class="btn btn-warning fw-bold px-4 shadow-sm" style="border-radius: 8px !important; background-color: #FCC30B; border: none;" onclick="batchManager.execute(0)" id="btnDeactivateBatch" disabled>
                            <i class="fas fa-times-circle me-2"></i> DEACTIVATE
                        </button>
                        <button type="button" class="btn btn-success fw-bold px-4 shadow-sm" style="border-radius: 8px !important; background-color: #166534; border: none;" onclick="batchManager.execute(1)" id="btnActivateBatch" disabled>
                            <i class="fas fa-check-circle me-2"></i> ACTIVATE
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .btn-xs { padding: 0.1rem 0.4rem; font-size: 0.75rem; line-height: 1.5; border-radius: 0.2rem; }
        #availableListContainer::-webkit-scrollbar, #targetedListContainer::-webkit-scrollbar { width: 6px; }
        #availableListContainer::-webkit-scrollbar-thumb, #targetedListContainer::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        #availableTableBody tr td, #targetedTableBody tr td { border-bottom: 1px solid rgba(0,0,0,0.03); }
        .target-btn { transition: all 0.2s ease; }
        .target-btn:hover { transform: translateX(3px); }
    </style>

    <script>
        const batchManager = {
            availableProjects: [],
            targetedProjects: [],
            
            init: async function() {
                this.setupEventListeners();
                await this.loadFilterData();
                this.search();
            },

            setupEventListeners: function() {
                ['batchFilterSdg', 'batchFilterYear', 'batchFilterType', 'batchFilterStatus'].forEach(id => {
                    document.getElementById(id).addEventListener('change', () => this.search());
                });
                document.getElementById('batchFilterKeyword').addEventListener('input', () => {
                    clearTimeout(this.searchTimeout);
                    this.searchTimeout = setTimeout(() => this.search(), 300);
                });
            },

            loadFilterData: async function() {
                try {
                    const response = await fetch('{{ path('admin_project_batch_filter_data') }}');
                    const data = await response.json();
                    
                    const sdgSelect = document.getElementById('batchFilterSdg');
                    data.sdgs.forEach(s => {
                        const opt = new Option(`SDG ${s.number}: ${s.name}`, s.id);
                        sdgSelect.add(opt);
                    });

                    const yearSelect = document.getElementById('batchFilterYear');
                    data.years.forEach(y => {
                        const opt = new Option(y, y);
                        yearSelect.add(opt);
                    });

                    const typeSelect = document.getElementById('batchFilterType');
                    data.types.forEach(t => {
                        const opt = new Option(t.name, t.id);
                        typeSelect.add(opt);
                    });
                } catch (e) {
                    console.error("Failed to load filter data", e);
                }
            },

            search: async function() {
                const filters = {
                    keyword: document.getElementById('batchFilterKeyword').value,
                    sdgId: document.getElementById('batchFilterSdg').value,
                    year: document.getElementById('batchFilterYear').value,
                    typeId: document.getElementById('batchFilterType').value,
                    isActive: document.getElementById('batchFilterStatus').value
                };

                try {
                    const response = await fetch('{{ path('admin_project_batch_search') }}', {
                        method: 'POST',
                        body: JSON.stringify(filters),
                        headers: { 'Content-Type': 'application/json' }
                    });
                    this.availableProjects = await response.json();
                    this.render();
                } catch (e) {
                    console.error("Search failed", e);
                }
            },

            render: function() {
                const availableBody = document.getElementById('availableTableBody');
                const targetedBody = document.getElementById('targetedTableBody');
                
                // Filter out already targeted ones from available list
                const targetedIds = new Set(this.targetedProjects.map(p => p.id));
                const filteredAvailable = this.availableProjects.filter(p => !targetedIds.has(p.id));

                availableBody.innerHTML = filteredAvailable.map(p => `
                    <tr>
                        <td class="ps-3 py-2">
                            <div class="fw-bold text-truncate" style="max-width: 300px;">${p.title}</div>
                            <div class="text-muted" style="font-size: 11px;">${p.year} • ${p.isActive ? '<span class="text-success">Active</span>' : '<span class="text-danger">Inactive</span>'}</div>
                        </td>
                        <td class="text-end pe-3 align-middle">
                            <button class="btn btn-outline-primary btn-xs" onclick="batchManager.target(${p.id})"><i class="fas fa-plus"></i></button>
                        </td>
                    </tr>
                `).join('') || '<tr><td colspan="2" class="text-center py-4 text-muted">No projects found matching filters</td></tr>';

                targetedBody.innerHTML = this.targetedProjects.map(p => `
                    <tr>
                        <td class="ps-3 py-2">
                            <div class="fw-bold text-truncate" style="max-width: 300px;">${p.title}</div>
                            <div class="text-muted" style="font-size: 11px;">${p.year}</div>
                        </td>
                        <td class="text-end pe-3 align-middle">
                            <button class="btn btn-outline-danger btn-xs" onclick="batchManager.untarget(${p.id})"><i class="fas fa-times"></i></button>
                        </td>
                    </tr>
                `).join('') || '<tr><td colspan="2" class="text-center py-4 text-muted small">No Projects Yet</td></tr>';

                document.getElementById('availableCount').textContent = filteredAvailable.length;
                document.getElementById('targetedCount').textContent = this.targetedProjects.length;
                
                const hasTargets = this.targetedProjects.length > 0;
                document.getElementById('btnActivateBatch').disabled = !hasTargets;
                document.getElementById('btnDeactivateBatch').disabled = !hasTargets;
                document.getElementById('btnDeleteBatch').disabled = !hasTargets;
            },

            target: function(id) {
                const project = this.availableProjects.find(p => p.id === id);
                if (project && !this.targetedProjects.find(p => p.id === id)) {
                    this.targetedProjects.push(project);
                    this.render();
                }
            },

            untarget: function(id) {
                this.targetedProjects = this.targetedProjects.filter(p => p.id !== id);
                this.render();
            },

            targetAll: function() {
                const targetedIds = new Set(this.targetedProjects.map(p => p.id));
                const newTargets = this.availableProjects.filter(p => !targetedIds.has(p.id));
                this.targetedProjects.push(...newTargets);
                this.render();
            },

            clearTargeted: function() {
                this.targetedProjects = [];
                this.render();
            },

            execute: async function(status) {
                const ids = this.targetedProjects.map(p => p.id);
                if (!confirm(`Are you sure you want to ${status ? 'ACTIVATE' : 'DEACTIVATE'} these ${ids.length} projects?`)) return;

                try {
                    const response = await fetch('{{ path('admin_project_batch_execute_toggle') }}', {
                        method: 'POST',
                        body: JSON.stringify({ ids, targetStatus: !!status }),
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const result = await response.json();
                    if (result.success) {
                        alert(`${result.count} projects updated successfully!`);
                        location.reload();
                    }
                } catch (e) {
                    alert("Execution failed. Please try again.");
                    console.error(e);
                }
            },

            executeDelete: async function() {
                const ids = this.targetedProjects.map(p => p.id);
                if (!confirm(`WARNING: This action is irreversible. Are you sure you want to PERMANENTLY DELETE these ${ids.length} projects?`)) return;

                try {
                    const response = await fetch('{{ path('admin_project_batch_execute_delete') }}', {
                        method: 'POST',
                        body: JSON.stringify({ ids }),
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const result = await response.json();
                    if (result.success) {
                        alert(`${result.count} projects deleted successfully!`);
                        location.reload();
                    }
                } catch (e) {
                    alert("Execution failed. Please try again.");
                    console.error(e);
                }
            }
        };

        document.getElementById('advancedBatchModal').addEventListener('show.bs.modal', () => batchManager.init());

        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('csvFileInput');
            const confirmBtn = document.getElementById('confirmImportBtn');
            const feedback = document.getElementById('fileValidationFeedback');

            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                
                if (!file) {
                    confirmBtn.disabled = true;
                    feedback.style.display = 'none';
                    return;
                }

                if (file.type !== 'text/csv' && !file.name.toLowerCase().endsWith('.csv')) {
                    showError("Invalid file type. Please upload a .csv file.");
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(event) {
                    const text = event.target.result;
                    const firstLine = text.split('\n')[0].toLowerCase(); 
                    
                    if (firstLine.includes('title') && (firstLine.includes('author') || firstLine.includes('authors'))) {
                        feedback.style.display = 'none';
                        confirmBtn.disabled = false;
                        fileInput.classList.remove('is-invalid');
                        fileInput.classList.add('is-valid');
                    } else {
                        showError("Header mismatch. Please ensure your CSV headers are exactly: Authors, Title, Abstract, DOI, Type, College, SDG");
                    }
                };
                reader.onerror = function() {
                    showError("Error reading file. Please try uploading again.");
                };

                const blob = file.slice(0, 1024);
                reader.readAsText(blob);
            });

            function showError(message) {
                confirmBtn.disabled = true;
                fileInput.classList.remove('is-valid');
                fileInput.classList.add('is-invalid');
                feedback.textContent = message;
                feedback.style.display = 'block';
                fileInput.value = ''; 
            }
        });
    </script>
{% endblock %}