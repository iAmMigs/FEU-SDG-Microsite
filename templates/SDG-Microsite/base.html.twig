<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}FEU Institute of Technology SDG Microsite{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% set sdg_colors = {
            1: '#E5243B', 2: '#DDA63A', 3: '#4C9F38', 4: '#C5192D', 5: '#FF3A21', 6: '#26BDE2',
            7: '#FCC30B', 8: '#A21942', 9: '#FD6925', 10: '#DD1367', 11: '#FD9D24', 12: '#BF8B2E',
            13: '#3F7E44', 14: '#0A97D9', 15: '#56C02B', 16: '#00689D', 17: '#19486A'
        } %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    
    <body class="flex flex-col min-h-screen font-sans text-gray-900 bg-white overflow-x-hidden">

            <div id="page-loader" class="fixed inset-0 z-[99999] bg-[#FCFCFC] flex flex-col items-center justify-center transition-opacity duration-500">
                <img src="{{ asset('images/loader.gif') }}" alt="Loading..." class="w-30 h-30 object-contain">
                <p class="mt-6 text-feu-green-800 font-bold tracking-widest uppercase text-sm animate-pulse">Loading...</p>
            </div>
            
            {% include 'SDG-Microsite/partials/header.html.twig' %}

            <main class="flex-grow">
                {% block body %}{% endblock %}
            </main>

            {% include 'SDG-Microsite/partials/footer.html.twig' %}

        
    </body>
</html>