{% extends 'SDG-Microsite/base.html.twig' %}

{% block title %}FEU Institute of Technology SDG Microsite - Advancing Sustainability{% endblock %}

{% block body %}
    <section class="relative h-screen w-full bg-feu-green-900 text-white overflow-hidden" data-controller="carousel">
        <div class="absolute inset-0 z-0 pointer-events-none">
            <img data-carousel-target="slide" src="{{ asset('images/hero-1.png') }}" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0" alt="FEU Institute of Technology Campus 1">
            <img data-carousel-target="slide" src="{{ asset('images/hero-2.jpg') }}" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0" alt="FEU Institute of Technology Campus 2">
            <img data-carousel-target="slide" src="{{ asset('images/hero-3.jpg') }}" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0" alt="FEU Institute of Technology Campus 3">
            <div class="absolute inset-0 bg-feu-green-900/70 mix-blend-multiply"></div>
        </div>

        <div class="relative h-full max-w-7xl mx-auto flex flex-col items-center justify-center text-center z-10 px-6">
            <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 font-bebas">
                Driving Sustainable Impact at FEU Institute of Technology
            </h1>
            <p class="text-lg md:text-2xl max-w-3xl mb-10 text-feu-green-50 font-work">
                Explore our research, student capstone and thesis projects, and community initiatives dedicated to solving global challenges through local action.
            </p>
            <a href="#goals" class="bg-[#FCC30B] text-feu-green-900 px-10 py-4 rounded-full font-bold text-lg hover:bg-yellow-300 transition duration-300 shadow-xl">
                Explore Our Focus Areas
            </a>
        </div>
    </section>

    <section id="goals" class="py-20 px-6 bg-gray-50">
        <div class="max-w-7xl mx-auto text-center mb-16">
            <h2 class="text-3xl font-bold text-gray-900 mb-4 font-bebas tracking-wide">Our Focus Areas</h2>
            <p class="text-gray-600 max-w-2xl mx-auto font-work">FEU Institute of Technology aligns its academic research, student theses, and institutional projects specifically toward these key Sustainable Development Goals.</p>
        </div>

        <div data-controller="modal" class="max-w-7xl mx-auto">
            
            <div class="flex justify-center mb-10">
                <div class="bg-gray-200 p-1 rounded-full flex gap-1 shadow-inner relative z-20">
                    <button type="button"
                            id="btn-focused-sdgs"
                            onclick="filterSdgs('focused')"
                            class="px-6 py-2 rounded-full text-sm font-bold font-work transition-all duration-300 bg-feu-green-900 text-white shadow-md cursor-pointer">
                        Focus
                    </button>
                    <button type="button"
                            id="btn-all-sdgs"
                            onclick="filterSdgs('all')"
                            class="px-6 py-2 rounded-full text-sm font-bold font-work transition-all duration-300 bg-gray-200 text-gray-600 hover:bg-gray-300 cursor-pointer">
                        All SDGs
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6 lg:gap-8">
                {% for sdg in all_sdgs %}
                    {% set formatted_num = '%02d'|format(sdg.num) %}
                    {% set is_active = sdg.num in active_sdg_ids %}
                    
                    <button type="button" 
                            data-modal-target="card"
                            data-action="click->modal#open"
                            data-goal="{{ sdg.num }}"
                            data-title="{{ sdg.title }}"
                            data-description="{{ sdg.long_desc }}"
                            data-active="{{ is_active ? 'true' : 'false' }}"
                            data-image="{{ asset('images/sdg/E-WEB-Goal-' ~ formatted_num ~ '.png') }}"
                            style="{{ is_active ? 'display: block; opacity: 1; transform: scale(1);' : 'display: none; opacity: 0; transform: scale(0.95);' }}"
                            class="sdg-card group relative rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-150 hover:-translate-y-2 border border-gray-100 bg-white aspect-square text-left focus:outline-none focus:ring-4 focus:ring-green-700/30 cursor-pointer">
                        
                        <img src="{{ asset('images/sdg/E-WEB-Goal-' ~ formatted_num ~ '.png') }}" alt="Goal {{ sdg.num }}" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-150 opacity-100 group-hover:opacity-0">
                        <img src="{{ asset('images/sdg/E Inverted Icons_WEB-' ~ formatted_num ~ '.png') }}" alt="Goal {{ sdg.num }}" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-150 opacity-0 group-hover:opacity-100">
                    </button>
                {% endfor %}
            </div>

            <div data-modal-target="backdrop" class="fixed inset-0 z-[100] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4 md:p-6">
                <div class="absolute inset-0 bg-black/60 backdrop-blur-md cursor-pointer" data-action="click->modal#close"></div>
                
                <div data-modal-target="panel" class="relative bg-white rounded-3xl overflow-hidden shadow-2xl w-full max-w-4xl flex flex-col md:flex-row transform opacity-0 scale-95 translate-y-4 transition-all duration-300 ease-out z-10 max-h-[90vh]">
                    
                    {# Close Button #}
                    <button type="button" data-action="click->modal#close" class="absolute top-6 right-6 z-20 text-gray-400 hover:text-gray-800 transition duration-200 focus:outline-none cursor-pointer">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>

                    {# LEFT SIDE: Image properly contained #}
                    <div class="md:w-1/2 p-8 md:p-12 flex items-center justify-center bg-white shrink-0">
                        <img data-modal-target="image" src="" alt="SDG Target Cover" class="w-full max-w-[320px] h-auto object-contain shadow-sm">
                    </div>
                    
                    {# RIGHT SIDE: Content, Title, and Buttons #}
                    <div class="md:w-1/2 p-8 md:p-12 md:pl-0 flex flex-col justify-center bg-white overflow-y-auto">
                        <div class="flex-grow flex flex-col justify-center">
                            
                            <h2 data-modal-target="title" class="text-3xl md:text-4xl font-bold text-feu-green-950 mb-4 font-bebas tracking-wide leading-tight uppercase pr-8">
                                Goal Title
                            </h2>
                            
                            <p data-modal-target="description" class="text-gray-600 text-sm md:text-base leading-relaxed font-work">
                                Goal Description
                            </p>
                        </div>
                        
                        <div data-modal-target="footerContainer" class="mt-8 pt-6 border-t border-gray-100 flex flex-col gap-4 text-center shrink-0">
                            <h4 data-modal-target="actionPrompt" class="text-xs font-bold text-gray-400 uppercase tracking-widest font-work">Which would you like to visit?</h4>
                            
                            <div data-modal-target="buttonsContainer" class="flex flex-col gap-3">
                                {# Library Button (Green) #}
                                <a href="#" data-modal-target="libraryBtn" data-base-url="{{ path('app_library') }}" class="block w-full text-center bg-feu-green-900 text-white font-bold px-5 py-3.5 rounded-xl hover:bg-feu-green-800 transition duration-300 font-work shadow-sm text-sm">
                                    SDG Related Project Library
                                </a>

                                {# Activities Button (Gold/Yellow) #}
                                <a href="#" data-modal-target="activityBtn" data-base-url="{{ path('app_news') }}" class="block w-full text-center bg-[#FCC30B] text-yellow-950 font-bold px-5 py-3.5 rounded-xl hover:bg-yellow-500 transition duration-300 font-work shadow-sm text-sm">
                                    SDG Related Activities
                                </a>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
            
            <script>
                let currentMode = 'focused';

                function filterSdgs(mode) {
                    if (currentMode === mode) return;
                    currentMode = mode;

                    const btnAll = document.getElementById('btn-all-sdgs');
                    const btnFocused = document.getElementById('btn-focused-sdgs');
                    const cards = document.querySelectorAll('.sdg-card');

                    if (mode === 'all') {
                        btnAll.className = "px-6 py-2 rounded-full text-sm font-bold font-work transition-all duration-300 bg-feu-green-900 text-white shadow-md cursor-pointer";
                        btnFocused.className = "px-6 py-2 rounded-full text-sm font-bold font-work transition-all duration-300 bg-gray-200 text-gray-600 hover:bg-gray-300 cursor-pointer";
                    } else {
                        btnFocused.className = "px-6 py-2 rounded-full text-sm font-bold font-work transition-all duration-300 bg-feu-green-900 text-white shadow-md cursor-pointer";
                        btnAll.className = "px-6 py-2 rounded-full text-sm font-bold font-work transition-all duration-300 bg-gray-200 text-gray-600 hover:bg-gray-300 cursor-pointer";
                    }

                    cards.forEach(card => {
                        const isActive = card.dataset.active === 'true';
                        const shouldShow = mode === 'all' || isActive;

                        if (shouldShow) {
                            card.style.display = 'block';
                            requestAnimationFrame(() => {
                                card.style.opacity = '1';
                                card.style.transform = 'scale(1)';
                            });
                        } else {
                            card.style.opacity = '0';
                            card.style.transform = 'scale(0.95)';
                            setTimeout(() => {
                                if (currentMode === 'focused' && !isActive) {
                                    card.style.display = 'none';
                                }
                            }, 150);
                        }
                    });
                }
            </script>
        </div>
    </section>

    <section class="relative py-24 px-6 overflow-hidden border-y-4 border-feu-gold-400">
        <div class="absolute inset-0 z-0">
            <img src="{{ asset('images/hero-2.jpg') }}" alt="FEU Institute of Technology Campus" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-feu-green-900/80 mix-blend-multiply"></div>
        </div>
        <div class="relative z-10 max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold text-white font-bebas tracking-wide mb-3">Featured voices in research</h2>
                <p class="text-feu-green-50 font-medium text-lg font-work max-w-2xl mx-auto">
                    Meet the dedicated students and faculty members driving sustainable innovation and impactful solutions at FEU Institute of Technology.
                </p>
            </div>
            
            {% if leading_voices|length > 0 %}
                <style>
                    @keyframes marquee-voices {
                        0% { transform: translateX(0%); }
                        100% { transform: translateX(-50%); }
                    }
                    .animate-marquee-voices {
                        display: flex;
                        width: max-content;
                        animation: marquee-voices 55s linear infinite;
                    }
                    .animate-marquee-voices:hover {
                        animation-play-state: paused;
                    }
                    .carousel-edge-fade {
                        mask-image: linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%);
                        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%);
                    }
                    .voice-card-static {
                        width: 275px !important;
                        min-width: 275px !important;
                        max-width: 275px !important;
                        height: 350px !important;
                        min-height: 350px !important;
                        max-height: 350px !important;
                        flex-shrink: 0 !important;
                        box-sizing: border-box !important;
                    }
                </style>
                
                {% set repeat_count = (leading_voices|length < 5) ? 5 : 1 %}

                {# Relative wrapper for arrow positioning — arrows sit within max-w-7xl visible bounds #}
                <div class="relative z-20 py-8">

                    {# Left Hover Arrow — anchored to the left side of the visible container #}
                    <button type="button" id="voice-arrow-left" aria-label="Scroll left"
                            class="absolute left-0 top-1/2 -translate-y-1/2 z-40 w-14 h-14 bg-white text-feu-green-900 rounded-full shadow-2xl border-2 border-[#FCC30B] flex items-center justify-center cursor-pointer opacity-50 hover:opacity-100 hover:bg-[#FCC30B] hover:text-feu-green-950 transition-all duration-300 hover:scale-110 active:scale-95 group">
                        <svg class="w-7 h-7 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                    </button>

                    {# Right Hover Arrow — anchored to the right side of the visible container #}
                    <button type="button" id="voice-arrow-right" aria-label="Scroll right"
                            class="absolute right-0 top-1/2 -translate-y-1/2 z-40 w-14 h-14 bg-white text-feu-green-900 rounded-full shadow-2xl border-2 border-[#FCC30B] flex items-center justify-center cursor-pointer opacity-50 hover:opacity-100 hover:bg-[#FCC30B] hover:text-feu-green-950 transition-all duration-300 hover:scale-110 active:scale-95 group">
                        <svg class="w-7 h-7 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                    </button>

                    {# Carousel track extends beyond container with negative margins for full-bleed effect #}
                    <div class="-mx-6 md:-mx-12 lg:-mx-16">
                    <div class="overflow-hidden carousel-edge-fade">
                        <div id="voice-marquee-track" class="animate-marquee-voices flex gap-8 px-4">
                            {% for i in 0..repeat_count %}
                                {% for voice in leading_voices %}
                                    <div class="voice-card-static bg-white rounded-2xl p-6 text-center shadow-xl hover:-translate-y-2 transition duration-300 group flex flex-col items-center justify-start">
                                        {% if voice.image %}
                                            <img src="{{ asset('uploads/voices/' ~ voice.image) }}" alt="{{ voice.name }}" class="w-20 h-20 shrink-0 mx-auto rounded-full object-cover mb-4 border-4 border-[#FCC30B] shadow-sm transition group-hover:scale-110">
                                        {% else %}
                                            {% set name_parts = voice.name|split(' ') %}
                                            {% set initials = (name_parts|first|slice(0,1) ~ name_parts|last|slice(0,1))|upper %}
                                            <div class="w-20 h-20 shrink-0 mx-auto bg-feu-green-100 text-feu-green-800 rounded-full flex items-center justify-center text-2xl font-black font-bebas mb-4 border-4 border-[#FCC30B] shadow-sm group-hover:bg-[#FCC30B] group-hover:text-feu-green-900 transition group-hover:scale-110">
                                                {{ initials }}
                                            </div>
                                        {% endif %}
                                        <h3 class="text-xl font-bold text-gray-900 font-bebas tracking-wide mb-1 line-clamp-1 w-full break-words overflow-hidden" title="{{ voice.name }}">{{ voice.name|length > 22 ? voice.name|slice(0, 22) ~ '...' : voice.name }}</h3>
                                        <p class="text-xs font-bold text-feu-green-700 uppercase tracking-wide mb-3 font-work line-clamp-1 w-full break-words overflow-hidden" title="{{ voice.title }}">{{ voice.title|length > 18 ? voice.title|slice(0, 18) ~ '...' : voice.title }}</p>
                                        <p class="text-sm text-gray-600 font-work leading-relaxed line-clamp-4 w-full break-words overflow-hidden" title="{{ voice.description }}">{{ voice.description|length > 100 ? voice.description|slice(0, 100) ~ '...' : voice.description }}</p>
                                    </div>
                                {% endfor %}
                            {% endfor %}
                    </div>
                    </div>
                    </div>
                </div>

                <script>
                    (function() {
                        function setupVoiceMarqueeHover() {
                            const track = document.getElementById('voice-marquee-track');
                            const leftBtn = document.getElementById('voice-arrow-left');
                            const rightBtn = document.getElementById('voice-arrow-right');

                            if (!track || !leftBtn || !rightBtn) return;

                            function getMarqueeAnimation() {
                                const anims = track.getAnimations();
                                return anims.length > 0 ? anims[0] : null;
                            }

                            leftBtn.addEventListener('mouseenter', () => {
                                const anim = getMarqueeAnimation();
                                if (anim) {
                                    anim.play();
                                    anim.playbackRate = -3.5;
                                }
                            });

                            leftBtn.addEventListener('mouseleave', () => {
                                const anim = getMarqueeAnimation();
                                if (anim) {
                                    anim.playbackRate = 1;
                                }
                            });

                            rightBtn.addEventListener('mouseenter', () => {
                                const anim = getMarqueeAnimation();
                                if (anim) {
                                    anim.play();
                                    anim.playbackRate = 3.5;
                                }
                            });

                            rightBtn.addEventListener('mouseleave', () => {
                                const anim = getMarqueeAnimation();
                                if (anim) {
                                    anim.playbackRate = 1;
                                }
                            });
                        }

                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', setupVoiceMarqueeHover);
                        } else {
                            setupVoiceMarqueeHover();
                        }
                        document.addEventListener('turbo:load', setupVoiceMarqueeHover);
                    })();
                </script>
            {% else %}
                <div class="text-center p-12 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20">
                    <p class="text-feu-green-50 font-medium font-work">Voices will appear here once added in the dashboard.</p>
                </div>
            {% endif %}
        </div>
    </section>

    <section class="py-24 px-6 bg-gray-50 border-t border-gray-100">
        <div class="max-w-7xl mx-auto">
            <div class="flex justify-between items-end mb-12">
                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 font-bebas tracking-wide mb-3">Latest Updates</h2>
                    <p class="text-lg text-gray-600 font-work">Stay informed with our newest research, seminars, and community events.</p>
                </div>
                <a href="{{ path('app_news') }}" class="hidden md:flex items-center gap-2 text-feu-green-700 font-bold hover:text-[#FCC30B] transition font-work">
                    View All News <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                {# 
                 * Limits the loop to a maximum of 3 items using the slice filter.
                 #}
                {% for activity in latest_activities|slice(0, 3) %}
                    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col hover:shadow-xl transition duration-300 group relative">
                        <div class="h-56 relative bg-gray-100 overflow-hidden shrink-0">
                            {% if activity.college %}
                                <div class="absolute z-20" style="top: 1.25rem; left: 1.25rem;">
                                    <span class="text-white text-[11px] font-bold rounded-full uppercase tracking-wider font-work inline-flex items-center gap-2 shrink-0 shadow-md border border-feu-gold-500/30 whitespace-nowrap" style="background-color: #0f4c28; color: #ffffff; padding: 0.35rem 1.1rem;">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" style="color: #f59e0b;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.5M4.5 21V10.5" />
                                        </svg>
                                        <span>{{ activity.college.name }}</span>
                                    </span>
                                </div>
                            {% endif %}
                            {% if activity.image %}
                                <img src="{{ asset('uploads/activities/' ~ activity.image) }}" alt="{{ activity.title }}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            {% else %}
                                <img src="{{ asset('images/hero-3.jpg') }}" alt="FEU Institute of Technology Event" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:scale-105 transition duration-500">
                            {% endif %}
                        </div>
  
                        <div class="p-8 flex flex-col flex-grow">
                             <div class="mb-4">
                                <div class="flex flex-nowrap items-center gap-2 mb-3 overflow-hidden">
                                    {% if activity.category %}
                                        <span class="bg-feu-green-900 text-white text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-widest shadow-sm shrink-0 whitespace-nowrap">{{ activity.category }}</span>
                                    {% endif %}
                                    {% include 'SDG-Microsite/partials/sdg_tags.html.twig' with { 'tags': activity.sdgs, 'limit': activity.category ? 1 : 2 } %}
                                </div>
                                <span class="text-gray-400 text-xs font-medium">{{ activity.eventDate|date('M j, Y') }}</span>
                            </div>
                            
                            {# Added line-clamp-2 here to prevent extra-long titles from breaking the card layout #}
                            <h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-feu-green-700 transition font-bebas tracking-wide line-clamp-2">
                                <a href="#">{{ activity.title }}</a>
                            </h3>
                            
                            <div class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-2 font-work max-w-none">
                                <p class="whitespace-pre-line">{{ activity.content|striptags }}</p>
                            </div>
                            
                            {# 
                             * Added mt-auto here. It forces the link to dynamically align 
                             * at the very bottom of the flex container, fixing the unequal button placement.
                             #}
                            <a href="{{ path('app_news_show', { id: activity.id }) }}" class="mt-auto text-feu-green-800 hover:text-feu-gold-600 font-bold text-sm transition-colors flex items-center gap-1 group font-work">
                                View Article
                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                             </a>
                        </div>
                    </article>
                {% else %}
                    <div class="col-span-3 p-12 text-center bg-white rounded-2xl border border-dashed border-gray-300">
                        <p class="text-gray-500 font-medium font-work">No recent updates found.</p>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-8 text-center md:hidden">
                <a href="{{ path('app_news') }}" class="inline-block bg-feu-green-800 text-white px-8 py-3 rounded-full font-bold font-work shadow-md">
                    View All News
                </a>
            </div>
        </div>
    </section>
{% endblock %}