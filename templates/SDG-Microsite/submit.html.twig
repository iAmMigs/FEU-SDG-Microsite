{% extends 'SDG-Microsite/base.html.twig' %}

{% block title %}Submit a Project / Event Request - FEU Institute of Technology SDG Microsite{% endblock %}

{% block body %}
    <section class="bg-feu-green-900 py-16 px-6 text-center border-b-4 border-feu-gold-400">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 font-bebas tracking-wide">Submit a Project / Event Request</h1>
            <p class="text-lg text-feu-green-50 font-medium font-work max-w-3xl mx-auto leading-relaxed">
                Are you an FEU Institute of Technology student or faculty member working on a project that aligns with the UN Sustainable Development Goals? Submit your research to be featured in our global library.
            </p>
        </div>
    </section>

    <section class="py-20 px-6 bg-gray-50 min-h-[500px]">
        <div class="max-w-5xl mx-auto">
            
            {% if categories is empty %}
                <div class="bg-white rounded-3xl p-12 text-center shadow-lg border border-gray-100">
                    <p class="text-gray-500 italic text-lg font-work">No requirement categories have been added yet.</p>
                </div>
            {% else %}
                {# Tab Category Buttons Navigation #}
                <div class="flex flex-wrap justify-center gap-3 mb-10 border-b border-gray-200 pb-6">
                    {% for cat in categories %}
                        <button 
                            type="button"
                            onclick="switchCategoryTab('category-tab-{{ cat.id }}', this)"
                            class="req-tab-btn px-6 py-3.5 rounded-full font-bold text-sm md:text-base tracking-wide transition duration-300 font-bebas uppercase flex items-center gap-2 shadow-sm border cursor-pointer {% if loop.first %}bg-feu-green-900 text-feu-gold-400 border-feu-green-900 shadow-md active-tab{% else %}bg-white text-gray-700 border-gray-200 hover:bg-gray-100 hover:text-gray-900{% endif %}"
                        >
                            <span class="w-2.5 h-2.5 rounded-full {% if loop.first %}bg-feu-gold-400{% else %}bg-gray-300{% endif %} tab-dot shrink-0"></span>
                            <span>{{ cat.name }}</span>
                        </button>
                    {% endfor %}
                </div>

                {# Tab Contents #}
                <div class="tab-contents-wrapper">
                    {% for cat in categories %}
                        <div 
                            id="category-tab-{{ cat.id }}" 
                            class="req-tab-pane bg-white rounded-3xl shadow-xl border border-gray-100 p-8 md:p-12 transition-all duration-300 {% if not loop.first %}hidden{% endif %}"
                        >
                            <div class="mb-8 border-b border-gray-100 pb-6">
                                <span class="text-xs font-bold text-feu-green-800 uppercase tracking-widest bg-feu-green-50 px-3 py-1.5 rounded-full inline-block mb-3">Requirement Category</span>
                                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 font-bebas tracking-wide uppercase mb-2">{{ cat.name }}</h2>
                                {% if cat.description %}
                                    <p class="text-gray-600 font-medium text-sm md:text-base font-work leading-relaxed">{{ cat.description }}</p>
                                {% endif %}
                                <div class="w-16 h-1.5 bg-feu-gold-400 mt-4"></div>
                            </div>

                            <ul class="space-y-6">
                                {% for step in cat.steps %}
                                    <li class="flex items-start gap-5 p-4 rounded-2xl hover:bg-gray-50/80 transition border border-transparent hover:border-gray-100">
                                        <div class="mt-1 w-8 h-8 bg-feu-gold-400 text-feu-green-950 rounded-full flex items-center justify-center font-bold font-bebas shrink-0 shadow-sm text-base">
                                            {{ loop.index }}
                                        </div>
                                        <div class="pt-0.5">
                                            <h3 class="font-bold text-gray-900 text-lg md:text-xl font-bebas tracking-wide mb-1 uppercase">{{ step.title }}</h3>
                                            {% if step.description %}
                                                <p class="text-gray-600 font-medium text-sm md:text-base font-work leading-relaxed italic">{{ step.description }}</p>
                                            {% endif %}
                                        </div>
                                    </li>
                                {% else %}
                                    <li class="text-gray-400 italic font-work py-4">No specific steps or guidelines added for this category yet.</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </section>

    <section class="py-20 px-6 bg-feu-green-900 text-center relative overflow-hidden border-t-4 border-feu-gold-400">
        <div class="max-w-3xl mx-auto relative z-10">
            <div class="mb-8 flex justify-center">
                <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center backdrop-blur-sm">
                    <svg class="w-8 h-8 text-feu-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
            </div>
            <h2 class="text-3xl font-bold text-white mb-6 font-bebas tracking-wide uppercase">Ready to submit?</h2>
            <p class="text-feu-green-50 font-medium text-xl mb-10 font-work leading-relaxed">
                Kindly send all submissions and inquiries to:
            </p>
            <a href="mailto:innovate@fit.edu.ph" class="inline-block bg-feu-gold-400 hover:bg-feu-gold-500 text-feu-green-950 text-2xl font-bold py-4 px-10 rounded-full transition shadow-xl font-work transform hover:scale-105">
                innovate@fit.edu.ph
            </a>
            <p class="mt-8 text-feu-green-200 text-sm font-work italic">
                Our team will review your submission and get back to you shortly.
            </p>
        </div>
        
        {# Decorative Elements #}
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-feu-gold-400/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-feu-green-400/10 rounded-full blur-3xl"></div>
    </section>

    <script>
        function switchCategoryTab(targetId, clickedBtn) {
            if (!clickedBtn) return;
            
            const tabButtons = document.querySelectorAll('.req-tab-btn');
            const tabPanes = document.querySelectorAll('.req-tab-pane');

            // 1. Reset all tab buttons styling
            tabButtons.forEach(btn => {
                btn.classList.remove('bg-feu-green-900', 'text-feu-gold-400', 'border-feu-green-900', 'shadow-md', 'active-tab');
                btn.classList.add('bg-white', 'text-gray-700', 'border-gray-200', 'hover:bg-gray-100', 'hover:text-gray-900');
                
                const dot = btn.querySelector('.tab-dot');
                if (dot) {
                    dot.classList.remove('bg-feu-gold-400');
                    dot.classList.add('bg-gray-300');
                }
            });

            // 2. Highlight clicked tab button
            clickedBtn.classList.remove('bg-white', 'text-gray-700', 'border-gray-200', 'hover:bg-gray-100', 'hover:text-gray-900');
            clickedBtn.classList.add('bg-feu-green-900', 'text-feu-gold-400', 'border-feu-green-900', 'shadow-md', 'active-tab');
            
            const activeDot = clickedBtn.querySelector('.tab-dot');
            if (activeDot) {
                activeDot.classList.remove('bg-gray-300');
                activeDot.classList.add('bg-feu-gold-400');
            }

            // 3. Hide all panes and display the target tab pane
            tabPanes.forEach(pane => {
                pane.classList.add('hidden');
            });

            const targetPane = document.getElementById(targetId);
            if (targetPane) {
                targetPane.classList.remove('hidden');
            }
        }
    </script>
{% endblock %}
