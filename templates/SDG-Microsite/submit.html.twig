{% extends 'SDG-Microsite/base.html.twig' %}

{% block title %}Submit a Project / Event Request - FEU Institute of Technology SDG Microsite{% endblock %}

{% block body %}
    <section class="bg-feu-green-900 py-16 px-6 text-center border-b-4 border-feu-gold-400">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 font-bebas tracking-wide">Submit a Project / Event Request</h1>
            <p class="text-lg text-feu-green-50 font-medium font-work max-w-3xl mx-auto leading-relaxed">
                Are you an FEU Institute of Technology student or faculty member working on a project that aligns with the UN Sustainable Development Goals? Submit your research to be featured in our global library.
            </p>
        </div>
    </section>

    <section class="py-24 px-6 bg-gray-50">
        <div class="max-w-6xl mx-auto">
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
                {# Card 1: Project Submission #}
                <div class="bg-white rounded-3xl shadow-2xl shadow-gray-200/50 border border-gray-100 overflow-hidden flex flex-col justify-between hover:shadow-3xl transition duration-300">
                    <div class="p-8 md:p-12">
                        <div class="mb-10">
                            <span class="text-xs font-bold text-feu-green-800 uppercase tracking-widest bg-feu-green-50 px-3 py-1.5 rounded-full inline-block mb-3">Option A</span>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 font-bebas tracking-wide uppercase">Project Submission</h2>
                            <p class="text-gray-500 font-medium text-sm font-work leading-relaxed">For researchers, students, and faculty members wishing to feature their academic and practical research in the global library.</p>
                            <div class="w-16 h-1.5 bg-feu-gold-400 mt-4"></div>
                        </div>

                        <ul class="space-y-8">
                            {% for req in projectRequirements %}
                                <li class="flex items-start gap-5">
                                    <div class="mt-1 w-6 h-6 bg-feu-gold-400 rounded-full flex items-center justify-center shrink-0 shadow-sm">
                                        <svg class="w-3.5 h-3.5 text-feu-green-900" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-900 text-lg font-bebas tracking-wide mb-0.5 uppercase">{{ req.title }}</h3>
                                        {% if req.description %}
                                            <p class="text-gray-600 font-medium text-sm font-work leading-relaxed italic">{{ req.description }}</p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% else %}
                                <p class="text-gray-400 italic">No requirements defined yet.</p>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                {# Card 2: Event/Activity Request #}
                <div class="bg-white rounded-3xl shadow-2xl shadow-gray-200/50 border border-gray-100 overflow-hidden flex flex-col justify-between hover:shadow-3xl transition duration-300">
                    <div class="p-8 md:p-12">
                        <div class="mb-10">
                            <span class="text-xs font-bold text-feu-green-800 uppercase tracking-widest bg-feu-green-50 px-3 py-1.5 rounded-full inline-block mb-3">Option B</span>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 font-bebas tracking-wide uppercase">Event / Activity Request</h2>
                            <p class="text-gray-500 font-medium text-sm font-work leading-relaxed">For booking and requesting events or activities on campus related to sustainable development goals.</p>
                            <div class="w-16 h-1.5 bg-feu-gold-400 mt-4"></div>
                        </div>

                        <ul class="space-y-8">
                            {% for req in eventRequirements %}
                                <li class="flex items-start gap-5">
                                    <div class="mt-1 w-6 h-6 bg-feu-gold-400 rounded-full flex items-center justify-center shrink-0 shadow-sm">
                                        <svg class="w-3.5 h-3.5 text-feu-green-900" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-900 text-lg font-bebas tracking-wide mb-0.5 uppercase">{{ req.title }}</h3>
                                        {% if req.description %}
                                            <p class="text-gray-600 font-medium text-sm font-work leading-relaxed italic">{{ req.description }}</p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% else %}
                                <p class="text-gray-400 italic">No requirements defined yet.</p>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section class="py-20 px-6 bg-feu-green-900 text-center relative overflow-hidden border-t-4 border-feu-gold-400">
        <div class="max-w-3xl mx-auto relative z-10">
            <div class="mb-8 flex justify-center">
                <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center backdrop-blur-sm">
                    <svg class="w-8 h-8 text-feu-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
            </div>
            <h2 class="text-3xl font-bold text-white mb-6 font-bebas tracking-wide uppercase">Ready to submit?</h2>
            <p class="text-feu-green-50 font-medium text-xl mb-10 font-work leading-relaxed">
                Kindly send all submissions and inquiries to:
            </p>
            <a href="mailto:innovate@fit.edu.ph" class="inline-block bg-feu-gold-400 hover:bg-feu-gold-500 text-feu-green-950 text-2xl font-bold py-4 px-10 rounded-full transition shadow-xl font-work transform hover:scale-105">
                innovate@fit.edu.ph
            </a>
            <p class="mt-8 text-feu-green-200 text-sm font-work italic">
                Our team will review your submission and get back to you shortly.
            </p>
        </div>
        
        {# Decorative Elements #}
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-feu-gold-400/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-feu-green-400/10 rounded-full blur-3xl"></div>
    </section>
{% endblock %}
