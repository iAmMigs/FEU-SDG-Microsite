{# templates/SDG-Microsite/partials/sdg_tags.html.twig #}
{% set limit = limit|default(3) %}
{% set total = tags|length %}

<div class="flex flex-nowrap items-center gap-2 align-items-center">
    {% for sdg in tags|slice(0, limit) %}
        <span class="text-white text-[10px] font-bold px-3 py-1.5 rounded-full font-work uppercase tracking-wider shadow-sm inline-flex items-center justify-center min-w-[80px] m-0" 
              style="background-color: {{ sdg_colors[sdg.id]|default('#166534') }}; text-shadow: 0px 1px 2px rgba(0,0,0,0.2);">
            SDG {{ sdg.id }}
        </span>
    {% else %}
        <span class="text-gray-400 text-[10px] font-bold px-3 py-1.5 rounded-full font-work uppercase tracking-wider border border-gray-200 bg-gray-50 inline-flex items-center justify-center min-w-[80px] m-0">
            No Specified SDG
        </span>
    {% endfor %}

    {% if total > limit %}
        <div class="relative group">
            <span class="bg-gray-100 text-gray-600 text-[10px] font-bold px-3 py-1.5 rounded-full font-work uppercase tracking-wider shadow-sm cursor-help border border-gray-200 group-hover:bg-gray-200 transition inline-flex items-center justify-center min-w-[38px]">
                +{{ total - limit }}
            </span>
            
            {# Tooltip - Simplified group-hover and increased z-index/shadow #}
            <div class="absolute top-full left-0 mt-2 w-72 bg-white rounded-2xl shadow-[0_25px_60px_rgba(0,0,0,0.25)] border border-gray-100 p-5 hidden group-hover:block z-[999] pointer-events-none">
                <div class="flex flex-col gap-3">
                    <p class="text-[10px] font-black text-feu-green-800 uppercase tracking-widest border-b border-gray-100 pb-2.5 mb-1">Associated Focus Areas</p>
                    {% for sdg in tags|slice(limit) %}
                        <div class="flex items-center gap-3.5">
                            <div class="w-3 h-3 rounded-full shrink-0 shadow-sm" style="background-color: {{ sdg_colors[sdg.id]|default('#166534') }}"></div>
                            <span class="text-[11px] font-bold text-gray-800 uppercase font-work leading-tight">SDG {{ sdg.id }}: {{ sdg.name }}</span>
                        </div>
                    {% endfor %}
                </div>
                {# Arrow #}
                <div class="absolute bottom-full left-4 -mb-px border-[10px] border-transparent border-b-white"></div>
            </div>
        </div>
    {% endif %}
</div>
