{# templates/SDG-Microsite/partials/submission_modal.html.twig #}
<div data-submission-modal-target="modal" class="fixed inset-0 z-[100000] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    {# Backdrop #}
    <div class="fixed inset-0 bg-feu-green-950/80 cursor-pointer" data-action="click->submission-modal#close"></div>

    <div class="fixed inset-0 z-10 overflow-y-auto pointer-events-none">
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-[2.5rem] bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-3xl pointer-events-auto border-4 border-feu-gold-400">
                
                {# Header Section #}
                <div class="h-40 bg-feu-green-900 relative overflow-hidden flex items-center px-12">
                    <div class="absolute inset-0 opacity-10">
                        <svg class="h-full w-full" fill="currentColor" viewBox="0 0 100 100" preserveAspectRatio="none">
                            <path d="M0 100 C 20 0 50 0 100 100 Z"></path>
                        </svg>
                    </div>
                    <div class="relative z-10">
                        <span class="text-feu-gold-400 font-bold uppercase tracking-[0.2em] text-xs mb-2 block animate-pulse">Contribution Guide</span>
                        <h2 class="text-4xl md:text-5xl font-black text-white font-bebas tracking-wider uppercase leading-none">Submit a Project</h2>
                    </div>
                    <button type="button" data-action="click->submission-modal#close" class="absolute top-6 right-6 text-white/50 hover:text-white hover:rotate-90 transition-all duration-300 p-2 rounded-full hover:bg-white/10">
                        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <div class="px-8 md:px-12 py-12">
                    <div class="space-y-12 font-work">
                        
                        {# Section 1: Required Details #}
                        <div>
                            <h3 class="text-feu-green-800 font-black uppercase tracking-widest text-sm mb-6 flex items-center gap-3">
                                <span class="w-8 h-8 rounded-xl bg-feu-green-100 text-feu-green-800 flex items-center justify-center text-xs font-black shadow-sm">01</span>
                                Required Details
                            </h3>
                            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 text-gray-700 font-bold text-sm list-none">
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Title of Event/Project
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Department/Office in Charge
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Date and Location
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Caption or Description
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Photos or Promotional Materials
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    SDG Goal(s) Addressed
                                </li>
                            </ul>
                        </div>

                        {# Section 2: Impact Information #}
                        <div class="pt-10 border-t border-gray-100">
                            <h3 class="text-feu-green-800 font-black uppercase tracking-widest text-sm mb-6 flex items-center gap-3">
                                <span class="w-8 h-8 rounded-xl bg-feu-green-100 text-feu-green-800 flex items-center justify-center text-xs font-black shadow-sm">02</span>
                                Impact Information
                            </h3>
                            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 text-gray-700 font-bold text-sm list-none">
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Objectives
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Target Beneficiaries
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Number of Participants
                                </li>
                                <li class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-feu-gold-300 transition duration-300">
                                    <div class="w-2 h-2 rounded-full bg-feu-gold-400 shadow-[0_0_8px_rgba(252,195,11,0.6)]"></div> 
                                    Key Outcomes or Impact
                                </li>
                            </ul>
                        </div>

                        {# Footer/Email CTA #}
                        <div class="bg-feu-green-900 rounded-[2rem] p-8 text-center relative overflow-hidden group">
                            <div class="absolute inset-0 bg-feu-gold-400 opacity-0 group-hover:opacity-5 transition-opacity duration-500"></div>
                            <p class="text-feu-green-100 font-bold text-sm mb-4 uppercase tracking-widest opacity-80">📩 Kindly send all submissions to:</p>
                            <a href="mailto:innovate@fit.edu.ph" class="text-2xl md:text-3xl font-black text-white hover:text-feu-gold-400 transition-colors duration-300 tracking-tight flex flex-col md:flex-row items-center justify-center gap-2">
                                innovate@fit.edu.ph
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 md:inline block mt-2 md:mt-0 opacity-50 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                                </svg>
                            </a>
                        </div>

                    </div>
                </div>

                <div class="bg-gray-50/50 px-12 py-8 flex justify-end border-t border-gray-100">
                    <button type="button" data-action="click->submission-modal#close" class="bg-white border-2 border-gray-200 text-gray-700 hover:bg-gray-100 hover:border-gray-300 font-black py-3 px-10 rounded-2xl transition-all duration-300 font-work text-sm shadow-sm hover:shadow-md">
                        Got it, thanks!
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
